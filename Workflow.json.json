            {
              "role": "system",
              "content": "You are an executive inbox triage assistant. Analyze the incoming email and return ONLY a valid JSON object with three keys:\n1. \"category\": Must be strictly one of: \"AI: Sales\", \"AI: Support\", \"AI: Billing\", or \"AI: Other\".\n2. \"needs_reply\": Boolean (true if a human or business response is appropriate, false for newsletters, notifications, or spam).\n3. \"draft_reply\": A polite, concise, professional reply draft (plain text, no subject line). If needs_reply is false, return an empty string \"\"."
            },
            {
              "content": "=From: {{ $json.From || $json.headers?.from || '' }}\nSubject: {{ $json.Subject || $json.headers?.subject || '' }}\nSnippet: {{ $json.snippet }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "store": false
        }
